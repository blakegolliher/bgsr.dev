---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Tools from '../components/Tools.astro';
import Career from '../components/Career.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Blake Golliher, storage engineer">
  <main>
    <Hero />
    <Tools />
    <Career />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  // Section entrances: each part rises once as it comes into view
  const parts = document.querySelectorAll('[data-reveal], .reveal-lines');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.1 });
    parts.forEach((el) => io.observe(el));
  } else {
    parts.forEach((el) => el.classList.add('is-in'));
  }
</script>
