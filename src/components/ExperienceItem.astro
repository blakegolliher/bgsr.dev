---
interface Props {
  company: string;
  role: string;
  period: string;
  description: string;
}

const { company, role, period, description } = Astro.props;
---

<div class="experience-item">
  <div class="experience-header">
    <span class="experience-prompt">$</span>
    <span class="experience-company">{company}</span>
    <span class="experience-separator">//</span>
    <span class="experience-role">{role}</span>
  </div>
  <div class="experience-period"># {period}</div>
  <p class="experience-description">{description}</p>
</div>

<style>
  .experience-item {
    padding: var(--space-md) 0;
    border-bottom: 1px dashed var(--text-secondary);
  }

  .experience-item:last-child {
    border-bottom: none;
  }

  .experience-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .experience-prompt {
    color: var(--accent-primary);
    font-weight: bold;
  }

  .experience-company {
    color: var(--text-bright);
    font-weight: 600;
    font-size: var(--font-size-lg);
  }

  .experience-separator {
    color: var(--text-secondary);
  }

  .experience-role {
    color: var(--text-primary);
  }

  .experience-period {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-sm);
  }

  .experience-description {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
    line-height: 1.6;
    padding-left: var(--space-md);
  }
</style>
