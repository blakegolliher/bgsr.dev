---
// The first screen: the full name across the top of the white panel, the portrait
// down the right-hand columns, then the "Moving data" intro.
---

<header class="hero" id="top">
  <div class="hero__panel">
    <h1 class="hero-name" data-fit>
      <span class="line"><span data-line style="--i: 0">Blake</span></span>{' '}
      <span class="line"><span data-line style="--i: 1">Golliher</span></span>
    </h1>
    <div class="hero__copy">
      <p class="hero__lead" data-load style="--d: 420ms">
        Field CTO at VAST Data. I write open-source tools that move live data between storage
        clusters, and measure it on the way.
      </p>
      <a class="button" data-load style="--d: 480ms" href="#tools">See the tools</a>
    </div>
    <nav class="hero__nav" aria-label="Sections">
      <a class="link" href="#tools">Tools</a>
      <a class="link" href="#career">Career</a>
      <a class="link" href="#contact">Contact</a>
    </nav>
    <a class="hero-corner link" href="#contact">Contact</a>
  </div>
  <figure class="hero__portrait" data-open>
    <img src="/images/blake.jpg" width="460" height="460" alt="Blake Golliher" fetchpriority="high" />
  </figure>
</header>

<section class="intro" aria-labelledby="intro-title">
  <h2 id="intro-title" class="intro__title reveal-lines">
    <span class="line"><span data-line style="--i: 0">Moving data</span></span>
  </h2>
  <p class="intro__statement" data-reveal style="--i: 2">
    Most of my work is moving data people are still using: buckets, exports, whole clusters. The
    address stays put. What’s underneath changes.
  </p>
  <figure class="intro__picture" data-reveal style="--i: 3">
    <div class="intro__frame">
      <img
        src="/images/proviso-yard-1942.jpg"
        width="1170"
        height="780"
        alt="A snow-covered railroad hump yard seen from above, steam rising over rows of freight cars and fanning switch tracks"
        loading="lazy"
      />
    </div>
    <figcaption>Proviso hump yard, Chicago &amp; North Western Railway, December 1942.</figcaption>
  </figure>
</section>

<script>
  import { fitText } from '../scripts/fit';
  fitText();
</script>

<style>
  /* Phones and tablets: name, portrait, then the sentence and button */
  .hero {
    position: relative;
    display: grid;
    grid-template-areas: 'name' 'portrait' 'copy';
    background: var(--field-1);
  }
  .hero__panel { display: contents; }
  .hero-name {
    grid-area: name;
    position: relative;
    padding: var(--margin);
    font-size: clamp(3.75rem, 17vw, 8.75rem);
    line-height: 0.85;
    letter-spacing: -0.035em;
  }
  .hero-name .line { padding-bottom: 0.12em; margin-bottom: -0.12em; }
  .hero-corner {
    position: absolute;
    top: var(--margin);
    right: var(--margin);
    font-weight: 500;
  }
  .hero__portrait {
    grid-area: portrait;
    margin: 0;
    height: 56svh;
    overflow: clip;
    background: #5f6b4a;
  }
  .hero__portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .hero__copy { grid-area: copy; padding: 1.5rem var(--margin) 2.5rem; }
  .hero__lead {
    max-width: 34ch;
    margin-bottom: 1.5rem;
    font-size: var(--step-lead);
    line-height: 1.35;
  }
  .hero__nav { display: none; }

  @media (min-width: 600px) and (max-width: 1099px) {
    .hero__portrait {
      height: auto;
      aspect-ratio: 4 / 5;
      width: min(60%, 460px);
      margin-left: var(--margin);
    }
  }

  .intro { padding: var(--section-gap) var(--margin) 0; }
  .intro__title { font-size: var(--step-head); }
  .intro__statement {
    max-width: 34ch;
    margin-top: 1.75rem;
    font-size: var(--step-lead);
    line-height: 1.35;
  }
  .intro__picture { margin-top: 2.5rem; }
  .intro__frame { overflow: clip; aspect-ratio: 3 / 2; background: #46525a; }
  .intro__frame img { width: 100%; height: 100%; object-fit: cover; }
  .intro__picture figcaption {
    margin-top: 0.6rem;
    font-size: var(--step-small);
    color: var(--muted);
  }

  /* Desktop: a white panel with the name on one line, the portrait full height */
  @media (min-width: 1100px) {
    .hero {
      grid-template-areas: none;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      height: 100svh;
      min-height: 40rem;
      padding-inline: var(--margin);
      background: none;
    }
    .hero__panel {
      grid-column: 1 / 10;
      grid-row: 1;
      position: relative;
      display: grid;
      grid-template-columns: calc(var(--margin) - var(--gutter)) repeat(9, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto 1.4fr;
      column-gap: var(--gutter);
      margin-left: calc(-1 * var(--margin));
      background: var(--field-1);
    }
    .hero-name {
      grid-area: auto;
      grid-column: 2 / -1;
      grid-row: 1;
      padding: var(--margin) var(--margin) 0 0;
      font-size: 6.6vw; /* fitted to the panel width once the face loads */
      white-space: nowrap;
    }
    .hero-name .line { display: inline-block; }
    .hero-corner { display: none; }
    .hero__copy { grid-area: auto; grid-column: 4 / 9; grid-row: 3; padding: 0; }
    .hero__lead { margin-bottom: 2rem; }
    .hero__nav {
      position: absolute;
      top: 50%;
      right: var(--gutter);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.35rem;
      transform: translateY(-50%);
      font-weight: 500;
    }
    .hero__portrait {
      grid-area: auto;
      grid-column: 10 / 13;
      grid-row: 1;
      height: 100%;
      margin-right: calc(-1 * var(--margin));
    }
    .hero__portrait img { object-position: 50% 25%; }

    /* the one centred moment: heading, sentence and the yard on one axis */
    .intro {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .intro > * { grid-column: 3 / 11; }
    .intro__frame { aspect-ratio: 16 / 9; }
  }

  /* Load: the name rises, the sentence and button follow, the portrait opens */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-name [data-line] {
      transform: translateY(105%);
      animation: hero-line 800ms var(--ease-expo) forwards;
      animation-delay: calc(100ms + var(--i) * var(--stagger-line));
    }
    :global(.js) .hero [data-load] {
      opacity: 0;
      transform: translateY(12px);
      animation: hero-rise 500ms var(--ease-out) forwards;
      animation-delay: var(--d);
    }
    :global(.js) .hero [data-open] {
      clip-path: inset(0 0 100% 0);
      animation: hero-open 1000ms var(--ease-in-out) 150ms forwards;
    }
    :global(.js) .hero [data-open] img {
      transform: scale(1.08);
      animation: hero-settle 1100ms var(--ease-expo) 100ms forwards;
    }
  }
  @keyframes hero-line { to { transform: none; } }
  @keyframes hero-rise { to { opacity: 1; transform: none; } }
  @keyframes hero-open { to { clip-path: inset(0); } }
  @keyframes hero-settle { to { transform: none; } }

  /* The yard drifts a little as it passes */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .intro__frame img {
        transform: scale(1.1);
        animation: yard-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes yard-drift {
    from { transform: scale(1.1) translateY(-4%); }
    to { transform: scale(1.1) translateY(4%); }
  }
</style>
